@model IEnumerable<BE2__ADMINLAYOUT.Models.Product>
@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Index</h2>
<h2>Quản lý sản phẩm</h2>

<p>
    @Html.ActionLink("Thêm sản phẩm", "Create", null,
        new { @class = "btn btn-primary" })
</p>

@using (Html.BeginForm("Index", "Products", FormMethod.Get))
{
    <input type="text" name="searchString"
           value="@ViewBag.SearchString"
           placeholder="Tên, mô tả hoặc danh mục" />

    <select name="sortOrder">
        <option value="">Tên A-Z</option>
        <option value="name_desc">Tên Z-A</option>
        <option value="price_asc">Giá tăng dần</option>
        <option value="price_desc">Giá giảm dần</option>
    </select>

    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Hình ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Danh mục</th>
            <th>Giá</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductID</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.ProductImage))
                    {
                        <img src="@Url.Content(item.ProductImage)"
                             alt="Ảnh sản phẩm"
                             style="width:70px;height:60px;object-fit:cover" />
                    }
                </td>
                <td>@item.ProductName</td>
                <td>@(item.Category == null ? "" : item.Category.CategoryName)</td>
                <td>@item.ProductPrice.ToString("N0") VNĐ</td>
                <td>
                    @Html.ActionLink("Chi tiết", "Details",
                        new { id = item.ProductID },
                        new { @class = "btn btn-info btn-sm" })

                    @Html.ActionLink("Sửa", "Edit",
                        new { id = item.ProductID },
                        new { @class = "btn btn-warning btn-sm" })

                    @Html.ActionLink("Xóa", "Delete",
                        new { id = item.ProductID },
                        new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
    {
        @Html.ActionLink(i.ToString(), "Index",
            new
                 {
                page = i,
                searchString = ViewBag.SearchString,
                sortOrder = ViewBag.SortOrder
            },
            new { @class = "btn btn-default btn-sm" })
    }
</div>
