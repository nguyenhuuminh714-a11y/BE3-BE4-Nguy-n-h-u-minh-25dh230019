@model BE2__ADMINLAYOUT.Models.Product
@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
}

<h2>Details</h2>

<h2>Chi tiết sản phẩm</h2>

<dl class="dl-horizontal">
    <dt>Mã sản phẩm</dt>
    <dd>@Model.ProductID</dd>

    <dt>Tên sản phẩm</dt>
    <dd>@Model.ProductName</dd>

    <dt>Danh mục</dt>
    <dd>@(Model.Category == null ? "" : Model.Category.CategoryName)</dd>

    <dt>Mô tả</dt>
    <dd>@Model.ProductDescription</dd>

    <dt>Giá</dt>
    <dd>@Model.ProductPrice.ToString("N0") VNĐ</dd>

    <dt>Hình ảnh</dt>
    <dd>
        @if (!string.IsNullOrEmpty(Model.ProductImage))
        {
            <img src="@Url.Content(Model.ProductImage)"
                 alt="Ảnh sản phẩm" style="max-width:250px" />
        }
    </dd>
</dl>

@Html.ActionLink("Sửa", "Edit", new { id = Model.ProductID },
    new { @class = "btn btn-warning" })

@Html.ActionLink("Quay lại", "Index", null,
    new { @class = "btn btn-default" })
