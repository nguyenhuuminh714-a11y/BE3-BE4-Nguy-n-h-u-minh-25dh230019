
@{
    ViewBag.Title = "View";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>View</h2>
<h2>Quản lý danh mục sản phẩm</h2>

<p>
    @Html.ActionLink("Thêm danh mục mới", "Create", null,
        new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã danh mục</th>
            <th>Tên danh mục</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CategoryID</td>
                <td>@item.CategoryName</td>
                <td>
                    @Html.ActionLink("Chi tiết", "Details",
                        new { id = item.CategoryID },
                        new { @class = "btn btn-info btn-sm" })

                    @Html.ActionLink("Sửa", "Edit",
                        new { id = item.CategoryID },
                        new { @class = "btn btn-warning btn-sm" })

                    @Html.ActionLink("Xóa", "Delete",
                        new { id = item.CategoryID },
                        new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>
